    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react-swc": "3.8.0",
    "gh-pages": "6.3.0",
    "typescript": "5.6.3",
    "vite": "5.4.19"
  }
